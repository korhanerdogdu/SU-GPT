# Copy to .env. Never commit real provider secrets.
APP_ENV=development
LLM_PROVIDER=groq
GROQ_API_KEY=replace_me
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# DeepSeek V4 Pro challenger through OpenRouter. Never commit a real key.
OPENROUTER_API_KEY=replace_me
OPENROUTER_MODEL=deepseek/deepseek-v4-pro
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REASONING_ENABLED=false
OPENROUTER_EXPERIMENTAL_ENABLED=false
OPENROUTER_REASONING_EFFORT=medium

# Reliability. Fallback is opt-in; use `groq` to enable one OpenRouter -> Groq hop.
LLM_FALLBACK_PROVIDER=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=0.25
LLM_MAX_RETRY_AFTER_SECONDS=10
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RECOVERY_SECONDS=30
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0

# Application authorization and repository-native resource controls.
# Generate fresh high-entropy values locally; never reuse these placeholders.
AUTH_TOKEN_SECRET=replace_with_at_least_32_random_bytes
AUTH_TOKEN_TTL_SECONDS=28800
ABUSE_HASH_SECRET=replace_with_at_least_32_random_bytes
ABUSE_HASH_SECRET_VERSION=v1
# Comma-separated version=secret entries used only during coordinated HMAC-key rotation.
ABUSE_HASH_PREVIOUS_SECRETS=
# `memory` is single-process. Select `redis` only when RATE_LIMIT_REDIS_URL is configured;
# a Redis error fails closed and never falls back to local counters.
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_NAMESPACE=advisu:rate-limit:v1
RATE_LIMIT_REDIS_TIMEOUT_SECONDS=0.25
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MAX_INPUT_CHARS=8000
MAX_OUTPUT_TOKENS=1024
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_FILES=10
MAX_UPLOAD_TOTAL_BYTES=26214400
REQUEST_TIMEOUT_SECONDS=60
PER_USER_REQUESTS_PER_MINUTE=30
PER_IP_REQUESTS_PER_MINUTE=60
LOGIN_ATTEMPTS_PER_MINUTE=5
STREAM_REQUESTS_PER_MINUTE=20
UPLOAD_REQUESTS_PER_MINUTE=10
COURSE_REVIEW_REQUESTS_PER_MINUTE=6
CONVERSATION_CREATIONS_PER_MINUTE=10
DAILY_PROVIDER_REQUEST_QUOTA=15
DAILY_TOKEN_QUOTA=100000
# Disabled until the product owner supplies an approved daily dollar budget.
DAILY_SPEND_LIMIT_USD=0
# Required and conservatively sized before enabling a positive daily spend limit.
PROVIDER_REQUEST_COST_RESERVATION_MICROUSD=0
SOFT_BUDGET_FRACTION=0.8
MAX_CONCURRENT_REQUESTS=4
RESOURCE_RESERVATION_TTL_SECONDS=120
CONVERSATION_RETENTION_DAYS=90
MAX_TRANSCRIPT_MESSAGES=200

# Course-only ratings remain disabled unless storage indexes, moderation staffing, retention,
# deletion, and privacy operations have been approved. Never reuse the abuse-limit HMAC key.
COURSE_REVIEWS_ENABLED=false
COURSE_REVIEWS_RELEASE_APPROVED=false
COURSE_REVIEW_HMAC_SECRET=replace_with_a_distinct_32_byte_secret
COURSE_REVIEW_CONSENT_VERSION=course-review-v1
COURSE_REVIEW_DIGEST_NAMESPACE=course-review-author-v1

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_admin_password
STUDENT_USERNAME=student
STUDENT_PASSWORD=replace_with_a_strong_student_password

MONGO_DB_NAME=advisu
DEFAULT_RETRIEVAL_MODE=hybrid_meta
DEFAULT_PROMPT_STRATEGY=structured_lookup
# Local Docker has persistent volumes and enables index construction by default.
# Keep this false on a 512 MB Render Free instance; see docs/deployment-render.md.
AUTO_BUILD_VECTOR_INDEX=true
ADVISU_LAB_DENSE=true
ADVISU_RERANK=off
CATALOG_TERM_CODES=202601,202502

FRONTEND_PORT=5173
BACKEND_PORT=8000
