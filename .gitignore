# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
myenv/
env/

# Backend secrets and runtime data
.env
server/.env
server/uploaded_pdfs/
server/uploaded_documents/
server/chroma_store/
# The production container writes to /app/chroma_store, which maps to this
# repository-root directory in some local workflows. It is generated and can
# be rebuilt from data/, so it must never be committed.
chroma_store/
sources/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Logs
*.log

# Evaluation outputs (CLAUDE.md 7.5).
# The small report artefacts ARE committed on purpose - they are the evidence behind
# docs/experiment_log.md and a reader must be able to check the numbers. Only bulky
# per-run dumps are excluded.
outputs/evaluation_runs/*/results.jsonl
outputs/evaluation_runs/*/retrieved_chunks.jsonl
outputs/evaluation_runs/raw_large_files/

# Local project notes / generated summaries
codebase_tech_stack_summary.txt
llm_message_flow.txt
prompt_vs_messages_explanation.txt
summary.txt
PROJE_DETAYLI_ACIKLAMA.txt
ACADEMIC_ADVISING_DATA_ROADMAP.md

# OS/editor files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# Retrieval lab: cached corpus embeddings are large, machine-specific and fully
# regenerable from the corpus (keyed by corpus fingerprint). Never commit them.
outputs/retrieval_cache/
outputs/retrieval_lab/*/rankings/

# Render/parser scratch artifacts (PDF/DOCX skills and corpus tests).
tmp/
# Provider pilot dumps are local by default. The explicitly re-included development runs contain
# only the redacted row schema (no prompts, response text, reasoning, headers, or raw errors) and
# are committed so reviewers can recompute the rejected exploratory aggregates.
outputs/provider_evaluation/*
!outputs/provider_evaluation/dev-pilot-20260804T120357Z/
!outputs/provider_evaluation/dev-pilot-20260804T215913Z/
outputs/provider_evaluation/dev-pilot-20260804T120357Z/*
outputs/provider_evaluation/dev-pilot-20260804T215913Z/*
!outputs/provider_evaluation/dev-pilot-20260804T120357Z/*.redacted.jsonl
!outputs/provider_evaluation/dev-pilot-20260804T120357Z/run_manifest.json
!outputs/provider_evaluation/dev-pilot-20260804T120357Z/artifact_checksums.json
!outputs/provider_evaluation/dev-pilot-20260804T120357Z/FINALIZED
!outputs/provider_evaluation/dev-pilot-20260804T215913Z/*.redacted.jsonl
!outputs/provider_evaluation/dev-pilot-20260804T215913Z/run_manifest.json
